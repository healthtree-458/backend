{
    "name": "backend",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "dev": "tsx watch --env-file=.env src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "migrate": "node dist/db/migrate.js",
        "migrate:dev": "tsx --env-file=.env src/db/migrate.ts",
        "typecheck": "tsc --noEmit",
        "test": "vitest run --passWithNoTests"
    },
    "dependencies": {
        "express": "^4.21.0",
        "helmet": "^8.0.0",
        "pg": "^8.13.0",
        "pino": "^9.4.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.16.0",
        "@types/pg": "^8.11.10",
        "pino-pretty": "^13.2.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^2.1.0"
    },
    "allowScripts": {
        "esbuild@0.28.2": true,
        "esbuild@0.21.5": true
    }
}
